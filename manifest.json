{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Gibberish Decoder"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "css": [
        "content.css"
      ],
      "js": [
        "src/dictionaries.js",
        "src/decoder.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "options_page": "options.html",
  "permissions": [
    "storage"
  ],
  "version": "1.0.5",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "fonts/Vazir.ttf",
        "fonts/Vazir-Thin.ttf",
        "fonts/Vazir-Light.ttf",
        "fonts/Vazir-Medium.ttf",
        "fonts/Vazir-Bold.ttf"
      ]
    }
  ]
}
